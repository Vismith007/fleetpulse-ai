{
  "name": "fleetpulse",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade IoT Fleet Monitoring Dashboard",
  "scripts": {
    "dev": "concurrently --names \"server,web\" --prefix-colors \"blue,green\" \"pnpm --filter @fleetpulse/server dev\" \"pnpm --filter @fleetpulse/web dev\"",
    "build": "pnpm --filter @fleetpulse/types build && pnpm --filter @fleetpulse/server build && pnpm --filter @fleetpulse/web build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @fleetpulse/types typecheck && pnpm --filter @fleetpulse/server typecheck && pnpm --filter @fleetpulse/web typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
